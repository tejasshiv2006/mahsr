{
  "expo": {
    "name": "MAHSR Connect One",
    "slug": "mahsr-connect-one",
    "scheme": "mahsrconnectone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tejas.mahsrconnectone"
    },
    "android": {
      "package": "com.tejas.mahsrconnectone",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForBuildTesting12345"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MAHSR Connect One to access your location for live train and station navigation."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1010e662-600e-452a-a5ff-8673f5c5f9bf"
      }
    },
    "owner": "tejas_shivgan"
  }
}